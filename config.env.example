# ----------------------------------------------------------------------------
# 1) 태그 — Grafana 에서 서버를 구분하는 값
# ----------------------------------------------------------------------------
HOST_TAG=""                 # 비우면 `hostname -s` 사용
ENV_TAG="dcloud"            # 전역 태그 env
ROLE_TAG="mirror"           # 전역 태그 role

# ----------------------------------------------------------------------------
# 2) InfluxDB (컨트롤러)
#    Kolla-Ansible(enable_influxdb: yes)은 InfluxDB 1.x 를 컨트롤러의
#    api_interface(내부망) IP : 8086 에 띄웁니다. 미러 서버에서 그 주소로 접근 가능해야 합니다.
# ----------------------------------------------------------------------------
INFLUX_VERSION="1"          # 1 = InfluxDB 1.x (Kolla 기본) / 2 = InfluxDB 2.x
INFLUX_URL="http://10.0.0.11:8086"
INFLUX_INSECURE_SKIP_VERIFY="no"   # https + 사설 인증서면 yes

# --- InfluxDB 1.x ---
INFLUX_DB="disk_health"
INFLUX_RETENTION="400d"     # SMART 는 장기 추세가 중요 → 1년 이상 권장 (INF = 무기한)
INFLUX_USER=""              # 인증 꺼져 있으면(Kolla 기본) 비워둠
INFLUX_PASSWORD=""
INFLUX_ADMIN_USER=""        # DB/RP 생성에 쓸 관리자 계정 (비우면 INFLUX_USER 사용)
INFLUX_ADMIN_PASSWORD=""

# --- InfluxDB 2.x ---  (INFLUX_VERSION="2" 일 때만 사용)
INFLUX_ORG="dcloud"
INFLUX_BUCKET="disk_health"
INFLUX_TOKEN=""             # 쓰기 + 버킷/DBRP 생성 권한 (all-access 또는 해당 권한)
#   2.x 에서도 Grafana 는 InfluxQL(DBRP 매핑) 로 조회합니다. DBRP 의 database 이름 = INFLUX_DB

INFLUX_INIT="yes"           # install.sh 실행 시 DB/RP(또는 bucket/DBRP) 자동 생성

# ----------------------------------------------------------------------------
# 3) 수집 설정
# ----------------------------------------------------------------------------
SMART_INTERVAL="5m"         # SMART 조회 주기 (너무 짧게 잡지 말 것: 1m 이상)
SMART_TIMEOUT="240s"        # 수집기 전체 타임아웃 (SMART_INTERVAL 보다 작아야 함)
IO_INTERVAL="30s"           # diskio / disk / mdstat 주기
DISKIO_DEVICES="sd[a-z] sd[a-z][a-z] nvme[0-9]*n[0-9] vd[a-z] xvd[a-z] hd[a-z] md*"

SKIP_STANDBY="yes"          # 스핀다운된 HDD 를 깨우지 않음
EXCLUDE_REGEX=""            # 제외할 장치 (예: "^/dev/(sdz|sr[0-9])")
#   RAID 컨트롤러 뒤 디스크 등 스캔에 안 잡히는 장치. 공백 구분 "경로:smartctl타입"
#   예) EXTRA_DEVICES="/dev/bus/0:megaraid,0 /dev/bus/0:megaraid,1 /dev/sda:cciss,0"
EXTRA_DEVICES=""
MAX_WORKERS="4"             # 동시에 조회할 디스크 수
DEVICE_TIMEOUT="60"         # 디스크 1개당 smartctl 타임아웃(초)
COLLECT_ATTRIBUTES="yes"    # ATA SMART 속성 원본(smart_attribute) 수집
COLLECT_ZFS="auto"          # auto | yes | no

# 경고(status_code=1) 기준
TEMP_WARN_HDD="50"
TEMP_WARN_SSD="65"
TEMP_WARN_NVME="70"
WEAR_WARN_PERCENT="80"

# ----------------------------------------------------------------------------
# 4) smartd — 정기 셀프테스트 (결과는 수집기가 last_selftest_* 로 올림)
# ----------------------------------------------------------------------------
MANAGE_SMARTD="yes"         # no 면 smartd 설정은 건드리지 않음
#   smartd -s 형식: T/MM/DD/d/HH   (d: 1=월 … 7=일)
#   기본: 매일 02시 Short, 매주 일요일 03시 Long  (Long 은 대용량 HDD 에서 수 시간 소요)
SMARTD_SCHEDULE="(S/../.././02|L/../../7/03)"
SMARTD_TEMP="4,50,60"       # -W 변화량,정보,위험 (°C)
